{
  "name": "pixel-vibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "validate": "./scripts/validate.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "canvas": "^3.2.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.1.6",
    "typescript": "^7.0.2",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /pixel-vibe && pnpm run typecheck'",
      "bash -c 'cd /pixel-vibe && pnpm run build'"
    ]
  }
}
